    {
      "parameters": {
        "jsCode": "const request = $('Validar consulta catálogo').first().json;\nif (request.ok !== true) return [{json:request}];\n\nconst rows = $input.all().map(i => i.json);\nconst events = [];\nconst registrations = [];\n\nfor (const row of rows) {\n  if (row && row.evento_id && row.nombre !== undefined && row.capacidad !== undefined) {\n    events.push(row);\n  } else if (row && row.inscripcion_id && row.evento_id) {\n    registrations.push(row);\n  }\n}\n\nconst confirmedByEvent = {};\n\nfor (const r of registrations) {\n  if (String(r.estado ?? '').toUpperCase() === 'CONFIRMADA') {\n    confirmedByEvent[r.evento_id] = (confirmedByEvent[r.evento_id] || 0) + 1;\n  }\n}\n\nconst publishable = events.filter(e =>\n  String(e.estado ?? '').toUpperCase() === 'PUBLICADO'\n);\n\nlet selected = publishable;\n\nif (request.operation === 'DETALLE') {\n  selected = publishable.filter(e => String(e.evento_id) === request.evento_id);\n} else if (request.operation === 'FILTRO') {\n  selected = publishable.filter(e =>\n    String(e.categoria ?? '').toLowerCase() === request.categoria.toLowerCase()\n  );\n}\n\nconst catalog = selected.map(e => {\n  const capacidad = Number(e.capacidad) || 0;\n  const confirmadas = confirmedByEvent[e.evento_id] || 0;\n  const cupos_disponibles = Math.max(0, capacidad - confirmadas);\n\n  return {\n    evento_id: e.evento_id,\n    nombre: e.nombre,\n    categoria: e.categoria,\n    descripcion: e.descripcion,\n    fecha: e.fecha,\n    hora: e.hora,\n    lugar: e.lugar,\n    capacidad,\n    cupos_confirmados: confirmadas,\n    cupos_disponibles,\n    disponible: cupos_disponibles > 0,\n    imagen_url: e.imagen_url,\n    organizador: e.organizador,\n    estado: e.estado\n  };\n});\n\nconst now = new Date().toISOString();\nconst consulta_id =\n  'CAT-' +\n  Math.random().toString(36).slice(2,10).toUpperCase() +\n  Date.now().toString(36).slice(-4).toUpperCase();\n\nreturn [{\n  json: {\n    ok: true,\n    status_http: 200,\n    consulta_id,\n    fecha: now,\n    tipo: request.operation,\n    evento_id: request.evento_id || '',\n    categoria: request.categoria || '',\n    resultado_count: catalog.length,\n    visitor_id: request.visitor_id || '',\n    eventos: catalog\n  }\n}];"
      },
