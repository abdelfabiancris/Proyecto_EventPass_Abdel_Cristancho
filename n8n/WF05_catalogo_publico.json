      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst operation = String(body.operation ?? 'LISTADO').trim().toUpperCase();\nconst allowed = ['LISTADO','DETALLE','FILTRO'];\n\nif (!allowed.includes(operation)) {\n  return [{json:{ok:false,error:'OPERACION_INVALIDA',message:'operation debe ser LISTADO, DETALLE o FILTRO',status_http:400}}];\n}\n\nconst evento_id = String(body.evento_id ?? '').trim();\nconst categoria = String(body.categoria ?? '').trim();\nconst visitor_id = String(body.visitor_id ?? '').trim();\n\nif (operation === 'DETALLE' && !evento_id) {\n  return [{json:{ok:false,error:'EVENTO_ID_REQUERIDO',message:'evento_id es obligatorio para DETALLE',status_http:400}}];\n}\n\nif (operation === 'FILTRO' && !categoria) {\n  return [{json:{ok:false,error:'CATEGORIA_REQUERIDA',message:'categoria es obligatoria para FILTRO',status_http:400}}];\n}\n\nreturn [{json:{ok:true,operation,evento_id,categoria,visitor_id,status_http:200}}];"
      },
