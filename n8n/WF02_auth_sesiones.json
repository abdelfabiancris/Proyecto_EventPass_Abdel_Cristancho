      "parameters": {
        "jsCode": "const session = $('Validar sesión y expiración').first().json;\nconst rows = $input.all().map(i => i.json);\nconst user = rows.find(r => String(r.usuario_id || '') === String(session.usuario_id || ''));\n\nif (!user) return [{json:{ok:false,error:'USUARIO_NO_ENCONTRADO',mensaje:'Usuario asociado a la sesión no existe'}}];\nif (String(user.estado || '').toUpperCase() !== 'ACTIVO') {\n  return [{json:{ok:false,error:'USUARIO_INACTIVO',mensaje:'El usuario está inactivo'}}];\n}\n\nreturn [{json:{\n  ok:true,\n  valida:true,\n  session_id:session.session_id,\n  usuario_id:user.usuario_id,\n  nombre:user.nombre,\n  email_normalizado:user.email_normalizado,\n  estado_usuario:user.estado,\n  estado_sesion:'ACTIVA',\n  expira_en:session.expira_en,\n  ultima_validacion:session.ultima_validacion\n}}];"
