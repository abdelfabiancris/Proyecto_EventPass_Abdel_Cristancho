    {
      "parameters": {
        "jsCode": "const input = $('Validar entrada auth').first().json;\nconst rows = $input.all().map(i => i.json);\nconst found = rows.find(r => String(r.email_normalizado || '').trim().toLowerCase() === input.email);\n\nif (!found) return [{json:{ok:false,error:'CREDENCIALES_INVALIDAS',mensaje:'Email o contraseña incorrectos'}}];\nif (String(found.estado || '').toUpperCase() !== 'ACTIVO') return [{json:{ok:false,error:'USUARIO_INACTIVO',mensaje:'El usuario está inactivo'}}];\n\n\nfunction sha256(ascii) {\n  function rightRotate(value, amount) {\n    return (value >>> amount) | (value << (32 - amount));\n  }\n  const maxWord = Math.pow(2, 32);\n  const words = [];\n  const asciiBitLength = ascii.length * 8;\n  let hash = sha256.h = sha256.h || [];\n  let k = sha256.k = sha256.k || [];\n  let primeCounter = k.length;\n  const isComposite = {};\n\n  for (let candidate = 2; primeCounter < 64; candidate++) {\n    if (!isComposite[candidate]) {\n      for (let i = 0; i < 8; i++) {\n        hash[primeCounter] = (Math.pow(candidate, 0.5) * maxWord) | 0;\n        k[primeCounter++] = (Math.pow(candidate, 1 / 3) * maxWord) | 0;\n      }\n      for (let candidate2 = candidate * candidate; candidate2 < 1000; candidate2 += candidate) {\n        isComposite[candidate2] = true;\n      }\n    }\n  }\n\n  ascii += '\\x80';\n  while (ascii.length % 64 - 56) ascii += '\\0';\n\n  for (let i = 0; i < ascii.length; i++) {\n    words[i >> 2] |= ascii.charCodeAt(i) << (((3 - i) % 4) * 8);\n  }\n\n  words[words.length] = ((asciiBitLength / maxWord) | 0);\n  words[words.length] = asciiBitLength;\n\n  for (let j = 0; j < words.length;) {\n    const w = words.slice(j, j += 16);\n    const oldHash = hash.slice(0, 8);\n\n    for (let i = 0; i < 64; i++) {\n      const w15 = w[i - 15];\n      const w2 = w[i - 2];\n      const a = hash[0];\n      const e = hash[4];\n\n      const temp1 = (\n        hash[7]\n        + (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25))\n        + ((e & hash[5]) ^ ((~e) & hash[6]))\n        + k[i]\n        + (w[i] = i < 16 ? w[i] :\n          (w[i - 16]\n            + (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 >>> 3))\n            + w[i - 7]\n            + (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 >>> 10))\n          ) | 0)\n      ) | 0;\n\n      const temp2 = (\n        (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22))\n        + ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]))\n      ) | 0;\n\n      hash = [\n        (temp1 + temp2) | 0,\n        hash[0], hash[1], hash[2],\n        (hash[3] + temp1) | 0,\n        hash[4], hash[5], hash[6]\n      ];\n    }\n\n    for (let i = 0; i < 8; i++) hash[i] = (hash[i] + oldHash[i]) | 0;\n  }\n\n  let result = '';\n  for (let i = 0; i < 8; i++) {\n    for (let j = 3; j >= 0; j--) {\n      const b = (hash[i] >> (j * 8)) & 255;\n      result += (b < 16 ? '0' : '') + b.toString(16);\n    }\n  }\n  return result;\n}\n\n\nconst calculated = sha256(input.password + String(found.password_salt || ''));\nif (calculated !== String(found.password_hash || '')) {\n  return [{json:{ok:false,error:'CREDENCIALES_INVALIDAS',mensaje:'Email o contraseña incorrectos'}}];\n}\n\nfunction randomToken(length = 48) {\n  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\n  let out = '';\n  for (let i = 0; i < length; i++) out += chars[Math.floor(Math.random() * chars.length)];\n  return out;\n}\n\nconst now = new Date();\nconst expires = new Date(now.getTime() + 2 * 60 * 60 * 1000);\nconst session_id = 'SES-' + randomToken(12).toUpperCase();\nconst session_token = randomToken(64);\n\nreturn [{json:{\n  ok:true,\n  usuario_id:found.usuario_id,\n  session_id,\n  session_token,\n  creada_en:now.toISOString(),\n  expira_en:expires.toISOString(),\n  estado:'ACTIVA',\n  cerrada_en:'',\n  ultima_validacion:now.toISOString()\n}}];"
      },
