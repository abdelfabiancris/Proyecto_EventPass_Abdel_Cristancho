        "jsCode": "const input = $('Validar entrada auth').first().json;\nconst rows = $input.all().map(i => i.json);\nconst found = rows.find(r => String(r.session_token || '') === input.session_token);\n\nif (!found) return [{json:{ok:false,error:'SESION_INVALIDA',mensaje:'Sesión inválida'}}];\nif (String(found.estado || '').toUpperCase() === 'CERRADA') {\n  return [{json:{ok:false,error:'SESION_CERRADA',mensaje:'La sesión está cerrada'}}];\n}\n\nconst now = new Date();\nconst expiry = new Date(found.expira_en);\nif (Number.isNaN(expiry.getTime())) {\n  return [{json:{ok:false,error:'SESION_INVALIDA',mensaje:'Fecha de expiración inválida'}}];\n}\n\nif (now >= expiry) {\n  return [{json:{\n    ok:false,\n    expirada:true,\n    session_id:found.session_id,\n    usuario_id:found.usuario_id,\n    session_token:found.session_token,\n    creada_en:found.creada_en,\n    expira_en:found.expira_en,\n    estado:'EXPIRADA',\n    cerrada_en:found.cerrada_en || '',\n    ultima_validacion:now.toISOString()\n  }}];\n}\n\nreturn [{json:{\n  ok:true,\n  valida:true,\n  session_id:found.session_id,\n  usuario_id:found.usuario_id,\n  session_token:found.session_token,\n  creada_en:found.creada_en,\n  expira_en:found.expira_en,\n  estado:'ACTIVA',\n  cerrada_en:found.cerrada_en || '',\n  ultima_validacion:now.toISOString()\n}}];"
      },
