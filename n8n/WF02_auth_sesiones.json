      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\n// Aceptamos ambos nombres para mantener compatibilidad\nconst operacion = String(\n  body.operacion ?? body.operation ?? ''\n)\n  .trim()\n  .toUpperCase();\n\nconst allowed = [\n  'LOGIN',\n  'LOGOUT',\n  'VALIDATE'\n];\n\nif (!allowed.includes(operacion)) {\n  throw new Error(\n    'operacion debe ser LOGIN, LOGOUT o VALIDATE'\n  );\n}\n\nconst email =\n  body.email == null\n    ? ''\n    : String(body.email)\n        .trim()\n        .toLowerCase();\n\nconst password =\n  body.password == null\n    ? ''\n    : String(body.password);\n\nconst session_token =\n  body.session_token == null\n    ? ''\n    : String(body.session_token).trim();\n\nif (\n  operacion === 'LOGIN' &&\n  (!email || !password)\n) {\n  throw new Error(\n    'email y password son obligatorios para LOGIN'\n  );\n}\n\nif (\n  ['LOGOUT', 'VALIDATE'].includes(operacion) &&\n  !session_token\n) {\n  throw new Error(\n    'session_token es obligatorio'\n  );\n}\n\nreturn [\n  {\n    json: {\n      operacion,\n      email,\n      password,\n      session_token\n    }\n  }\n];"
      },
