    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst events = rows.filter(row =>\n  row.evento_id &&\n  row.capacidad !== undefined &&\n  row.nombre !== undefined\n);\n\nconst registrations = rows.filter(row =>\n  row.inscripcion_id &&\n  row.evento_id &&\n  row.estado !== undefined\n);\n\nconst promotions = [];\n\nfor (const event of events) {\n\n  const eventId = String(event.evento_id).trim();\n  const eventState = String(event.estado ?? '').trim().toUpperCase();\n\n  if (eventState !== 'PUBLICADO') {\n    continue;\n  }\n\n  const eventRegistrations = registrations.filter(row =>\n    String(row.evento_id).trim() === eventId\n  );\n\n  const confirmed = eventRegistrations.filter(row =>\n    String(row.estado ?? '').trim().toUpperCase() === 'CONFIRMADA'\n  );\n\n  const waiting = eventRegistrations\n    .filter(row =>\n      String(row.estado ?? '').trim().toUpperCase() === 'LISTA_ESPERA'\n    )\n    .sort((a, b) =>\n      new Date(a.fecha_inscripcion) -\n      new Date(b.fecha_inscripcion)\n    );\n\n  const capacity = Number(event.capacidad) || 0;\n  const available = Math.max(\n    0,\n    capacity - confirmed.length\n  );\n\n  const amountToPromote = Math.min(\n    available,\n    waiting.length\n  );\n\n  for (let i = 0; i < amountToPromote; i++) {\n\n    const registration = waiting[i];\n\n    promotions.push({\n      json: {\n        reasignacion_id:\n          'REA-' +\n          Math.random()\n            .toString(36)\n            .slice(2, 10)\n            .toUpperCase(),\n\n        evento_id: eventId,\n\n        inscripcion_id:\n          registration.inscripcion_id,\n\n        usuario_id:\n          registration.usuario_id,\n\n        fecha:\n          new Date().toISOString(),\n\n        orden_lista:\n          i + 1,\n\n        estado_anterior:\n          'LISTA_ESPERA',\n\n        estado_nuevo:\n          'CONFIRMADA',\n\n        resultado_notificacion:\n          'PENDIENTE'\n      }\n    });\n  }\n}\n\nreturn promotions;"
      },
