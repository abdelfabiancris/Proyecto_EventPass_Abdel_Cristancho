    {
      "parameters": {
        "jsCode": "\nconst req = $('Validar entrada eventos').first().json;\nconst rows = $input.all().map(i => i.json);\nconst op = req.operation;\n\nif (op === 'READ') {\n  if (req.evento_id) {\n    const found = rows.find(r => String(r.evento_id ?? '').trim() === req.evento_id);\n    if (!found) return [{json:{ok:false,error:'EVENTO_NO_ENCONTRADO',evento_id:req.evento_id}}];\n    return [{json:{ok:true,operation:'READ',evento:found}}];\n  }\n  return [{json:{ok:true,operation:'READ',eventos:rows}}];\n}\n\nif (op === 'CREATE') {\n  const newId = 'EVT-' + Date.now().toString(36).toUpperCase();\n  const now = new Date().toISOString();\n  const newEvent = {\n    evento_id:newId,\n    nombre:req.nombre,\n    categoria:req.categoria,\n    descripcion:req.descripcion,\n    fecha:req.fecha,\n    hora:req.hora,\n    lugar:req.lugar,\n    capacidad:req.capacidad,\n    imagen_url:req.imagen_url,\n    organizador:req.organizador,\n    estado:req.estado || 'BORRADOR',\n    fecha_creacion:now,\n    fecha_actualizacion:now\n  };\n  const duplicate = rows.some(r =>\n    String(r.nombre ?? '').trim().toLowerCase() === newEvent.nombre.toLowerCase() &&\n    String(r.fecha ?? '').trim() === newEvent.fecha &&\n    String(r.hora ?? '').trim() === newEvent.hora &&\n    String(r.estado ?? '').toUpperCase() !== 'CANCELADO'\n  );\n  if (duplicate) return [{json:{ok:false,error:'EVENTO_DUPLICADO',mensaje:'Ya existe un evento con el mismo nombre, fecha y hora.'}}];\n  return [{json:{...newEvent,operation:'CREATE'}}];\n}\n\nconst found = rows.find(r => String(r.evento_id ?? '').trim() === req.evento_id);\nif (!found) return [{json:{ok:false,error:'EVENTO_NO_ENCONTRADO',evento_id:req.evento_id,operation:op}}];\n\nif (op === 'UPDATE') {\n  const updated = {\n    ...found,\n    nombre:req.nombre || found.nombre,\n    categoria:req.categoria || found.categoria,\n    descripcion:req.descripcion || found.descripcion,\n    fecha:req.fecha || found.fecha,\n    hora:req.hora || found.hora,\n    lugar:req.lugar || found.lugar,\n    capacidad:req.capacidad ?? found.capacidad,\n    imagen_url:req.imagen_url || found.imagen_url,\n    organizador:req.organizador || found.organizador,\n    estado:req.estado || found.estado,\n    fecha_actualizacion:new Date().toISOString()\n  };\n  return [{json:{...updated,operation:'UPDATE'}}];\n}\n\nif (op === 'CLOSE' || op === 'CANCEL') {\n  const updated = {\n    ...found,\n    estado: op === 'CLOSE' ? 'CERRADO' : 'CANCELADO',\n    fecha_actualizacion:new Date().toISOString(),\n    operation:op\n  };\n  return [{json:updated}];\n}\n\nthrow new Error('Operación no soportada');\n"
      },
