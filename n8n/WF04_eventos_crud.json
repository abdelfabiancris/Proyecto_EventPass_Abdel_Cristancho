    {
      "parameters": {
        "jsCode": "\nconst body = $input.first().json;\nconst operation = String(body.operation ?? '').trim().toUpperCase();\nconst adminKey = String(body.admin_key ?? '').trim();\nconst expectedAdminKey = 'REPLACE_WITH_ADMIN_KEY';\n\nconst allowed = ['CREATE','READ','UPDATE','CLOSE','CANCEL'];\nif (!allowed.includes(operation)) {\n  throw new Error('Operación inválida. Use CREATE, READ, UPDATE, CLOSE o CANCEL.');\n}\nif (!adminKey || adminKey !== expectedAdminKey) {\n  throw new Error('ADMIN_NO_AUTORIZADO');\n}\n\nconst evento_id = String(body.evento_id ?? '').trim();\nconst nombre = String(body.nombre ?? '').trim();\nconst categoria = String(body.categoria ?? '').trim();\nconst descripcion = String(body.descripcion ?? '').trim();\nconst fecha = String(body.fecha ?? '').trim();\nconst hora = String(body.hora ?? '').trim();\nconst lugar = String(body.lugar ?? '').trim();\nconst imagen_url = String(body.imagen_url ?? '').trim();\nconst organizador = String(body.organizador ?? '').trim();\nconst estado = String(body.estado ?? '').trim().toUpperCase();\nconst capacidadRaw = body.capacidad;\nconst capacidad = capacidadRaw === '' || capacidadRaw == null ? null : Number(capacidadRaw);\n\nif (['UPDATE','CLOSE','CANCEL','READ'].includes(operation) && !evento_id) {\n  throw new Error(`Para ${operation} se requiere evento_id`);\n}\n\nif (['CREATE','UPDATE'].includes(operation)) {\n  if (!nombre) throw new Error('Se requiere nombre');\n  if (!categoria) throw new Error('Se requiere categoria');\n  if (!descripcion) throw new Error('Se requiere descripcion');\n  if (!fecha) throw new Error('Se requiere fecha');\n  if (!hora) throw new Error('Se requiere hora');\n  if (!lugar) throw new Error('Se requiere lugar');\n  if (!organizador) throw new Error('Se requiere organizador');\n  if (capacidad === null || !Number.isFinite(capacidad) || capacidad <= 0) {\n    throw new Error('capacidad debe ser un número mayor que 0');\n  }\n}\nif (estado && !['BORRADOR','PUBLICADO','CERRADO','CANCELADO'].includes(estado)) {\n  throw new Error('Estado inválido');\n}\n\nreturn [{\n  json:{\n    ok:true, operation, evento_id, nombre, categoria, descripcion, fecha, hora,\n    lugar, capacidad, imagen_url, organizador, estado\n  }\n}];\n"
      },
