    {
      "parameters": {
        "jsCode": "const message = $json.message ?? {};\n\nconst text = String(message.text ?? '').trim();\n\nconst parts = text.split(/\\s+/);\n\nconst command = String(parts[0] ?? '').toLowerCase();\nconst codigo = String(parts[1] ?? '').trim().toUpperCase();\n\nconst caracteresValidos =\n  'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n\nconst codigoValido =\n  codigo.length === 6 &&\n  [...codigo].every(char =>\n    caracteresValidos.includes(char)\n  );\n\nif (command !== '/vincular' || !codigoValido) {\n  return [\n    {\n      json: {\n        ok: false,\n        ignorar: true,\n        chat_id: String(message.chat?.id ?? ''),\n        telegram_username: String(\n          message.from?.username ?? ''\n        ),\n        mensaje: 'Usa: /vincular CODIGO'\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ok: true,\n      codigo,\n      chat_id: String(message.chat?.id ?? ''),\n      telegram_username: String(\n        message.from?.username ?? ''\n      )\n    }\n  }\n];"
      },
