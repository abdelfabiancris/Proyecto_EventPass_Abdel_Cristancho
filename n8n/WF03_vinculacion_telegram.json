        "jsCode": "const req=$('Validar solicitud de vinculacion').first().json; const rows=$input.all().map(i=>i.json); const found=rows.find(r=>String(r.session_token||'')===req.session_token&&String(r.usuario_id||'')===req.usuario_id&&String(r.estado||'').toUpperCase()==='ACTIVA'&&new Date(r.expira_en).getTime()>Date.now()); if(!found)return[{json:{ok:false,error:'SESION_INVALIDA',mensaje:'La sesión no es válida o ya expiró'}}]; const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let codigo=''; for(let i=0;i<6;i++)codigo+=chars[Math.floor(Math.random()*chars.length)]; const now=new Date(),exp=new Date(now.getTime()+600000); return[{json:{ok:true,codigo_id:'COD-'+now.getTime().toString(36).toUpperCase(),usuario_id:req.usuario_id,codigo,creado_en:now.toISOString(),expira_en:exp.toISOString(),estado:'PENDIENTE',usado_en:''}}];"
