      "parameters": {
        "jsCode": "const input=$('Execute Sub-workflow Trigger - Notificaciones').first().json; const rows=$input.all().map(x=>x.json); const u=rows.find(x=>String(x.usuario_id)===String(input.usuario_id)&&x.email_normalizado); const t=rows.find(x=>String(x.usuario_id)===String(input.usuario_id)&&x.chat_id&&String(x.estado).toUpperCase()==='ACTIVA');\nif(!u) return [{json:{ok:false,error:'USUARIO_NO_ENCONTRADO'}}];\nreturn [{json:{...input,email:u.email_normalizado,chat_id:t?.chat_id||'',nombre:u.nombre,notificacion_id:'NOT-'+Math.random().toString(36).slice(2,10).toUpperCase(),fecha:new Date().toISOString(),gmail_estado:'PENDIENTE',telegram_estado:t?'PENDIENTE':'NO_APLICA',gmail_error:'',telegram_error:'',clave_idempotencia:input.clave_idempotencia||`${input.usuario_id}|${input.evento_id||''}|${input.tipo||''}`}}];"
      },
