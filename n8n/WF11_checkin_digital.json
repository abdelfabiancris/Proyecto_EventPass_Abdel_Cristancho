    {
      "parameters": {
        "jsCode": "\nconst req = $('Validar solicitud').first().json;\nconst now = new Date().toISOString();\n\nlet resultado = 'RECHAZADO';\nlet detalle = '';\nlet ins = null;\nlet evento = null;\nlet usuario_id = '';\n\nif (req.ok === false) {\n  detalle = req.detalle || 'SOLICITUD_INVALIDA';\n} else {\n  const regs = $('Consultar inscripciones').all().map(x => x.json);\n  const events = $('Consultar eventos').all().map(x => x.json);\n  const hist = $('Consultar historial check-in').all().map(x => x.json);\n\n  ins = regs.find(\n    x => String(x.inscripcion_id ?? '') === req.inscripcion_id\n  );\n\n  evento = events.find(\n    x => String(x.evento_id ?? '') === req.evento_id\n  );\n\n  if (!ins) {\n    detalle = 'INSCRIPCION_NO_ENCONTRADA';\n  } else if (!evento) {\n    detalle = 'EVENTO_NO_ENCONTRADO';\n  } else if (String(ins.evento_id ?? '') !== req.evento_id) {\n    detalle = 'EVENTO_NO_CORRESPONDE_A_INSCRIPCION';\n  } else if (String(ins.estado ?? '').toUpperCase() === 'ASISTIO') {\n    resultado = 'DUPLICADO';\n    detalle = 'INGRESO_YA_REGISTRADO';\n  } else if (String(ins.estado ?? '').toUpperCase() !== 'CONFIRMADA') {\n    detalle = 'ESTADO_NO_PERMITE_INGRESO:' +\n      String(ins.estado ?? 'SIN_ESTADO');\n  } else if (\n    hist.some(\n      x =>\n        String(x.inscripcion_id ?? '') === req.inscripcion_id &&\n        String(x.resultado ?? '').toUpperCase() === 'EXITOSO'\n    )\n  ) {\n    resultado = 'DUPLICADO';\n    detalle = 'INGRESO_YA_REGISTRADO';\n  } else {\n    resultado = 'EXITOSO';\n    detalle = 'CHECKIN_REGISTRADO';\n  }\n\n  usuario_id = ins?.usuario_id || '';\n}\n\nconst checkin_id =\n  'CHK-' +\n  Math.random().toString(36).slice(2, 10).toUpperCase() +\n  Date.now().toString(36).slice(-4).toUpperCase();\n\nreturn [{\n  json: {\n    ok: resultado === 'EXITOSO',\n    checkin_id,\n    inscripcion_id: req.inscripcion_id || '',\n    evento_id: req.evento_id || '',\n    usuario_id,\n    fecha_checkin: now,\n    resultado,\n    detalle,\n    estado_inscripcion: ins?.estado || '',\n    evento_nombre: evento?.nombre || '',\n    status_http:\n      resultado === 'EXITOSO' ? 200 :\n      resultado === 'DUPLICADO' ? 409 :\n      detalle.startsWith('FALTAN_DATOS') ? 400 : 422\n  }\n}];\n"
      },
