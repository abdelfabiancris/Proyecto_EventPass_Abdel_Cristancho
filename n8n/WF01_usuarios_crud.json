      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst op = String(body.operacion ?? body.operation ?? '').trim().toUpperCase();\nconst allowed = ['CREATE','READ','UPDATE','DEACTIVATE'];\nif (!allowed.includes(op)) throw new Error('operacion debe ser CREATE, READ, UPDATE o DEACTIVATE');\n\nconst email = body.email == null ? '' : String(body.email).trim().toLowerCase();\nconst nombre = body.nombre == null ? '' : String(body.nombre).trim();\nconst usuario_id = body.usuario_id == null ? '' : String(body.usuario_id).trim();\nconst password = body.password == null ? '' : String(body.password);\n\nif (['CREATE','UPDATE'].includes(op) && !nombre) throw new Error('nombre es obligatorio');\nif (op === 'CREATE' && !email) {\n  throw new Error('email es obligatorio');\n}\nif (op === 'CREATE' && password.length < 8) throw new Error('password debe tener minimo 8 caracteres');\nif (['READ','UPDATE','DEACTIVATE'].includes(op) && !usuario_id && !email) {\n  throw new Error('usuario_id o email es obligatorio');\n}\n\nreturn [{json:{\n  operacion: op,\n  nombre, email, password, usuario_id,\n  estado: body.estado ? String(body.estado).trim().toUpperCase() : undefined,\n  observaciones: body.observaciones ?? ''\n}}];"
