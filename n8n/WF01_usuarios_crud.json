      "parameters": {
        "jsCode": "const input = $('Validar y normalizar entrada').first().json;\nconst rows = $input.all().map(i => i.json);\n\n// Normalizar email\nconst email = String(input.email || '').trim().toLowerCase();\n\n// Buscar email duplicado\nconst duplicate = rows.some(\n  r => String(r.email_normalizado || '').trim().toLowerCase() === email\n);\n\nif (duplicate) {\n  return [{\n    json: {\n      ok: false,\n      error: 'EMAIL_DUPLICADO',\n      mensaje: 'Ya existe un usuario con ese email',\n      email,\n      operacion: 'CREATE'\n    }\n  }];\n}\n\n// Generar salt\nconst salt = Math.random().toString(36).substring(2, 14)\n  + Date.now().toString(36);\n\n// Función hash SHA-256 usando una implementación compatible con Code Node\nfunction sha256(ascii) {\n  function rightRotate(value, amount) {\n    return (value >>> amount) | (value << (32 - amount));\n  }\n\n  const mathPow = Math.pow;\n  const maxWord = mathPow(2, 32);\n  let result = '';\n  const words = [];\n  const asciiBitLength = ascii.length * 8;\n\n  let hash = sha256.h = sha256.h || [];\n  const k = sha256.k = sha256.k || [];\n  let primeCounter = k.length;\n\n  const isComposite = {};\n\n  for (let candidate = 2; primeCounter < 64; candidate++) {\n    if (!isComposite[candidate]) {\n      for (let i = 0; i < 8; i++) {\n        hash[primeCounter] = (Math.pow(candidate, 0.5) * maxWord) | 0;\n        k[primeCounter++] =\n          (Math.pow(candidate, 1 / 3) * maxWord) | 0;\n      }\n\n      for (let candidate2 = candidate * candidate;\n           candidate2 < 1000;\n           candidate2 += candidate) {\n        isComposite[candidate2] = true;\n      }\n    }\n  }\n\n  ascii += '\\x80';\n\n  while (ascii.length % 64 - 56) {\n    ascii += '\\0';\n  }\n\n  for (let i = 0; i < ascii.length; i++) {\n    const j = ascii.charCodeAt(i);\n    words[i >> 2] |= j << ((3 - i) % 4 * 8);\n  }\n\n  words[words.length] = ((asciiBitLength / maxWord) | 0);\n  words[words.length] = asciiBitLength;\n\n  for (let j = 0; j < words.length;) {\n    const w = words.slice(j, j += 16);\n    const oldHash = hash.slice(0, 8);\n\n    for (let i = 0; i < 64; i++) {\n      const w15 = w[i - 15];\n      const w2 = w[i - 2];\n\n      const a = hash[0];\n      const e = hash[4];\n\n      const temp1 =\n        (hash[7]\n          + (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25))\n          + ((e & hash[5]) ^ ((~e) & hash[6]))\n          + k[i]\n          + (w[i] =\n            i < 16\n              ? w[i]\n              : (\n                  w[i - 16]\n                  + (rightRotate(w15, 7)\n                    ^ rightRotate(w15, 18)\n                    ^ (w15 >>> 3))\n                  + w[i - 7]\n                  + (rightRotate(w2, 17)\n                    ^ rightRotate(w2, 19)\n                    ^ (w2 >>> 10))\n                ) | 0\n          )\n        ) | 0;\n\n      const temp2 =\n        (\n          (rightRotate(a, 2)\n            ^ rightRotate(a, 13)\n            ^ rightRotate(a, 22))\n          + ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]))\n        ) | 0;\n\n      hash = [\n        (temp1 + temp2) | 0,\n        hash[0],\n        hash[1],\n        hash[2],\n        (hash[3] + temp1) | 0,\n        hash[4],\n        hash[5],\n        hash[6]\n      ];\n    }\n\n    for (let i = 0; i < 8; i++) {\n      hash[i] = (hash[i] + oldHash[i]) | 0;\n    }\n  }\n\n  for (let i = 0; i < 8; i++) {\n    for (let j = 3; j + 1; j--) {\n      const b = (hash[i] >> (j * 8)) & 255;\n      result += ((b < 16) ? '0' : '') + b.toString(16);\n    }\n  }\n\n  return result;\n}\n\n// Combinar contraseña + salt\nconst password = String(input.password || '');\nconst passwordHash = sha256(password + salt);\n\n// Generar ID de usuario\nconst usuario_id =\n  'USR-' +\n  Math.random().toString(36).substring(2, 10).toUpperCase();\n\n// Fecha actual\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    ok: true,\n    usuario_id,\n    nombre: input.nombre,\n    email_normalizado: email,\n    password_hash: passwordHash,\n    password_salt: salt,\n    estado: 'ACTIVO',\n    fecha_registro: now,\n    fecha_actualizacion: now\n  }\n}];"
      },
