    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres el asistente oficial de EventPass.\n\nTu función es brindar soporte únicamente informativo.\n\nPuedes responder preguntas sobre:\n- eventos\n- categorías\n- fechas\n- horarios\n- lugares\n- disponibilidad\n- lista de espera\n- vinculación de Telegram\n- estados de inscripción\n- funcionamiento general de EventPass\n\nRESTRICCIONES:\n- No puedes crear usuarios.\n- No puedes iniciar sesión.\n- No puedes crear inscripciones.\n- No puedes cancelar inscripciones.\n- No puedes modificar eventos.\n- No puedes cambiar cupos.\n- No puedes cambiar estados del negocio.\n- No inventes información.\n\nEVENTOS DISPONIBLES:\n{{ JSON.stringify($('Consultar eventos - solo lectura').all().map(item => item.json)) }}\n\nPREGUNTA DEL USUARIO:\n{{ $('Chat Trigger - EventPass Assistant').first().json.chatInput }}\n\nResponde en español, de forma clara y breve.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -128,
        192
      ],
      "id": "50428694-89ed-4fd7-a0dd-f0342c4abeba",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -64,
        432
      ],
      "id": "b678e412-f028-46f7-b290-7eb8338a66ff",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "TCmUiY01lcedfC3Z",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst trigger = $('Chat Trigger - EventPass Assistant').first().json;\n\nconst eventos = rows\n  .filter(e =>\n    e.evento_id &&\n    e.nombre &&\n    String(e.estado ?? '').toUpperCase() === 'PUBLICADO'\n  )\n  .map(e => ({\n    evento_id: e.evento_id,\n    nombre: e.nombre,\n    categoria: e.categoria,\n    descripcion: e.descripcion,\n    fecha: e.fecha,\n    hora: e.hora,\n    lugar: e.lugar,\n    capacidad: e.capacidad,\n    estado: e.estado\n  }));\n\nreturn [{\n  json: {\n    chatInput: trigger.chatInput || '',\n    conversation_id:\n      trigger.conversation_id ||\n      `CONV-${Math.random().toString(36).slice(2,10).toUpperCase()}`,\n    usuario_id: trigger.usuario_id || '',\n    visitor_id:\n  trigger.visitor_id ||\n  trigger.sessionId ||\n  `VIS-${Math.random().toString(36).slice(2,10).toUpperCase()}`,\n    eventos\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        192
      ],
      "id": "0fe15473-049a-4e51-ac68-919f4cb31590",
      "name": "Preparar contexto IA"
    },
    {
      "parameters": {
        "jsCode": "const context = $('Preparar contexto IA').first().json;\n\nconst respuesta =\n  $json.text ||\n  $json.output ||\n  $json.response ||\n  '';\n\nreturn [\n  {\n    json: {\n      conversation_id: context.conversation_id || '',\n      usuario_id: context.usuario_id || '',\n      visitor_id: context.visitor_id || '',\n      user_message: context.chatInput || '',\n      assistant_message: respuesta,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        224
      ],
      "id": "43f21747-72e5-43df-bce0-bcb86da7c757",
      "name": "Formatear respuesta IA"
    },
    {
      "parameters": {
        "jsCode": "const data =\n  $('Formatear respuesta IA').first().json;\n\nreturn [\n  {\n    json: {\n      output:\n        data.assistant_message || ''\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
