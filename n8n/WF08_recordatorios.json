    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(x => x.json);\n\nconst events = rows.filter(x =>\n  x.evento_id &&\n  x.fecha &&\n  x.hora &&\n  x.capacidad !== undefined &&\n  x.nombre !== undefined\n);\n\nconst regs = rows.filter(x =>\n  x.inscripcion_id &&\n  x.usuario_id &&\n  x.evento_id &&\n  x.estado &&\n  x.origen\n);\n\nconst old = rows.filter(x =>\n  x.recordatorio_id &&\n  x.clave_idempotencia\n);\n\nconst now = new Date();\n\nconst debug = [];\n\nfor (const e of events.filter(x =>\n  String(x.estado).trim().toUpperCase() === \"PUBLICADO\"\n)) {\n\n  const dt = new Date(\n    `${String(e.fecha).trim()}T${String(e.hora).trim()}:00-05:00`\n  );\n\n  const diff = (dt.getTime() - now.getTime()) / 3600000;\n\n  const eventRegs = regs.filter(r =>\n    String(r.evento_id).trim() === String(e.evento_id).trim()\n  );\n\n  for (const r of eventRegs) {\n\n    const estado = String(r.estado).trim().toUpperCase();\n\n    const key =\n      `${r.usuario_id}|${e.evento_id}|24H`;\n\n    debug.push({\n      json: {\n        evento_id: e.evento_id,\n        fecha_evento: e.fecha,\n        hora_evento: e.hora,\n        horas_faltantes: diff,\n        inscripcion_id: r.inscripcion_id,\n        usuario_id: r.usuario_id,\n        estado,\n        es_confirmada: estado === \"CONFIRMADA\",\n        clave: key,\n        ya_existe_recordatorio: old.some(\n          x => String(x.clave_idempotencia).trim() === key\n        )\n      }\n    });\n  }\n}\n\nreturn debug;"
      },
